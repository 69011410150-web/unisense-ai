mixin () {
  // Static Markdown description of the public backend API. Authored from the
  // current source; it reads no runtime state.
  public query func getApiDoc() : async Text {
    "# UniSense AI — Backend API\n"
    # "\n"
    # "UniSense AI เป็นผู้ช่วยมหาวิทยาลัยแบบสาธิต (prototype) สำหรับนักศึกษา "
    # "แบ็กเอนด์ให้ข้อมูลตารางเรียน แผนที่อาคาร/ห้อง เส้นทางเดิน รถ EV สายสาธิต "
    # "และผู้ช่วยตอบคำถามแบบกฎ (rule-based) ข้อมูลทั้งหมดเป็น DEMO DATA "
    # "ไม่เชื่อมต่อระบบมหาวิทยาลัยจริง ไม่มีข้อมูลส่วนบุคคลจริง และไม่มีการติดตามตำแหน่ง GPS จริง\n"
    # "\n"
    # "## การยืนยันตัวตนและสิทธิ์ (Authentication & Authorization)\n"
    # "\n"
    # "- ทุกเมธอดของโดเมนแคมปัส (รายการด้านล่าง) เป็น `query` และ **เปิดให้เรียกได้โดยไม่ต้องล็อกอิน** "
    # "รวมถึงผู้เรียกแบบ anonymous เพราะข้อมูลเป็นชุดสาธิตที่ไม่ใช่ข้อมูลส่วนบุคคล\n"
    # "- ระบบสิทธิ์ (authorization) ถูกติดตั้งไว้ในแคนนิสเตอร์ (`_initialize_access_control` และเมธอดจัดการบทบาท) "
    # "แต่เมธอดโดเมนแคมปัสในเวอร์ชันนี้ไม่ได้ตรวจสอบบทบาทผู้เรียก\n"
    # "- `scan()` เป็นเมธอดเดียวที่เป็น update call (ไม่ใช่ query) และคืนผลตรวจจับสาธิตคงที่ "
    # "(อาคารวิทยาศาสตร์ 2 / ชั้น 2 / ห้อง SC-204) ทุกครั้งที่เรียก\n"
    # "- ฟรอนต์เอนด์ผูก Internet Identity กับ derivation origin ของแอป (เผยแพร่ที่ `/.well-known/ii-derivation-origin` เมื่อมี) "
    # "เอเจนต์ที่ถือสิทธิ์ Internet Identity ของผู้ใช้อยู่แล้วจะได้ principal ประจำแอปที่ถูกต้องเมื่อ derive กับ origin นั้น "
    # "(เช่น `icp identity link web <name> --app <host>`) การมอบสิทธิ์นี้จะกระทำการแทนผู้ใช้ด้วยอำนาจเต็มในแอปนี้จนกว่าจะหมดอายุ\n"
    # "- การลงทะเบียนผู้ใช้ (access control) เกิดขึ้นเมื่อผู้ใช้ล็อกอินผ่านฟรอนต์เอนด์ของแอปเท่านั้น "
    # "ผู้เรียกที่ยังไม่เคยล็อกอินผ่านแอปจะยังไม่ถูกลงทะเบียน แม้จะเป็นเจ้าของแอปก็ตาม และผู้เรียกที่ derive principal "
    # "กับ origin อื่นจะเป็น principal คนละตัวกับที่ฟรอนต์เอนด์ลงทะเบียนไว้\n"
    # "\n"
    # "## โดเมนแคมปัส (query — เปิดสาธารณะ)\n"
    # "\n"
    # "- `listBuildings() : [Building]` — อาคารทั้งหมดในชุดสาธิต (`id`, `code`, `name`, `description`, `floors`)\n"
    # "- `listRooms() : [Room]` — ห้องเรียนทั้งหมด (`id`, `code`, `buildingId`, `buildingName`, `floor`, `description`)\n"
    # "- `listLocations() : [CampusLocation]` — จุดอ้างอิงบนแผนที่ (`id`, `name`, `kind`, `description`) "
    # "โดย `kind` เป็นป้ายภาษาไทย เช่น \"อาคาร\", \"โรงอาหาร\", \"จุดจอด EV\"\n"
    # "- `listRouteSegments() : [RouteSegment]` — ช่วงทางเดินระหว่างสองจุด "
    # "(`fromLocationId`, `toLocationId`, `distanceMetres`, `walkingMinutes`, `instruction`)\n"
    # "- `listEvLines() : [EvLine]` — รถ EV สายสาธิต (`id`, `name`, `stops`, `nextStation`, `arrivalMinutes`, `crowdLevel`)\n"
    # "- `getCurrentLocation() : CampusLocation` — ตำแหน่งเริ่มต้นของนักศึกษาในเดโม (ตำแหน่งแรกของชุดข้อมูล) "
    # "ไม่ใช่ตำแหน่งจริงจากอุปกรณ์\n"
    # "- `listSchedule() : [ClassEntry]` — ตารางเรียนรายสัปดาห์ (`id`, `subject`, `day`, `startTime`, `endTime`, "
    # "`buildingName`, `roomCode`, `instructor`)\n"
    # "- `getProfile() : StudentProfile` — โปรไฟล์นักศึกษาสาธิต (`displayName`, `studentId`, `faculty`, `year`, `avatarPlaceholder`)\n"
    # "- `getNextClass() : ?NextClass` — คาบถัดไปของวันเดโม พร้อม `minutesUntil` (นาทีจนถึงเวลาเริ่ม) "
    # "คืนค่า `null` เมื่อไม่มีคาบเหลือในวันนั้น\n"
    # "- `planRoute(originName : Text, destinationName : Text) : RoutePlan` — วางแผนเส้นทางระหว่างสองชื่อสถานที่ "
    # "ชื่อสถานที่รับได้ทั้งชื่อเต็มในชุดข้อมูล รหัสห้อง (เช่น `SC-204`) และคำเรียกสั้นที่นักศึกษาใช้จริง "
    # "(เช่น `ตึกวิทยาศาสตร์` จะจับคู่กับ `อาคารวิทยาศาสตร์ 2`) เมื่อปลายทางเป็นห้อง "
    # "`destinationName` จะเป็นรหัสห้องนั้น เพื่อให้ฟรอนต์เอนด์เติมปลายทางในหน้าแผนที่นำทางได้ทันที\n"
    # "- `askCampus(question : Text) : AssistantAnswer` — ผู้ช่วยตอบคำถามแบบกฎ "
    # "คำถาม \"อีก 30 นาทีฉันมีเรียนที่ไหน?\" จะได้คาบถัดไปพร้อม `route` เส้นทางที่แนะนำจากตำแหน่งเดโมไปยังห้องเรียนนั้น\n"
    # "- `getSmartMoment() : ?SmartMoment` — คำแนะนำเชิงรุก (proactive) ของ Smart Moment "
    # "คำนวณจากตารางเรียนเดโมและเส้นทางที่แนะนำจากตำแหน่งเดโมไปยังห้องเรียนคาบถัดไป "
    # "คืนค่า `null` เมื่อไม่มีคาบเรียนเหลือในวันเดโม\n"
    # "\n"
    # "### Smart Moment (`getSmartMoment`)\n"
    # "\n"
    # "`getSmartMoment()` เป็น **query แบบอ่านอย่างเดียว** และ **deterministic** "
    # "ให้ผลเหมือนกันทุกครั้งที่เรียก เพราะใช้เวลาจำลองคงที่ 08:30 น. และวันเดโม \"จันทร์\" เท่านั้น "
    # "ไม่มีการอ่านเวลาจริงของอุปกรณ์หรือตำแหน่ง GPS จริง\n"
    # "\n"
    # "ฟิลด์ที่คืนค่า:\n"
    # "\n"
    # "- `subject`, `startTime`, `buildingName`, `roomCode` — คาบถัดไปของวันเดโม\n"
    # "- `minutesRemaining` — นาทีที่เหลือก่อนคาบเริ่ม\n"
    # "- `walkingMinutes`, `evMinutes`, `finalWalkingMinutes`, `totalMinutes` — เวลาเดินช่วงแรก เวลารถ EV เวลาเดินช่วงท้าย และเวลารวม (นาที)\n"
    # "- `estimatedArrival` — เวลาถึงโดยประมาณ รูปแบบ `\"HH:MM\"`\n"
    # "- `arriveBeforeClass` — `true` เมื่อเวลารวมของเส้นทางไม่เกินเวลาที่เหลือก่อนคาบเริ่ม\n"
    # "- `situation` — ระดับสถานการณ์ เป็น variant: `#A` (มีเวลาเพียงพอ), `#B` (เวลากระชั้น แต่เส้นทางที่เร็วที่สุดยังทัน), `#C` (เส้นทางปกติไปไม่ทัน)\n"
    # "- `situationMessage` — ข้อความภาษาไทยของระดับสถานการณ์นั้น\n"
    # "- `explanation` — คำอธิบายสั้น ๆ ว่า AI วิเคราะห์จากตารางเรียน เวลา และเส้นทาง\n"
    # "- `originName`, `destinationName` — ชื่อต้นทาง/ปลายทางที่แนะนำสำหรับส่งต่อเส้นทางไปหน้าแผนที่\n"
    # "\n"
    # "กติกาการเลือกระดับสถานการณ์ (ใช้เวลาเดโมคงที่เท่านั้น):\n"
    # "\n"
    # "- `#A` เมื่อเวลาที่เหลือมากกว่าเวลารวมของเส้นทางอย่างชัดเจน (มากกว่า 5 นาที) — ที่เวลาเดโม 08:30 น. "
    # "เหลือ 30 นาที เส้นทางรวม 10 นาที จึงเป็น `#A` พร้อมข้อความ \"คุณยังมีเวลา 20 นาที แนะนำให้ออกเดินทางตอนนี้\"\n"
    # "- `#B` เมื่อเวลาที่เหลือน้อยกว่าหรือเท่ากับเวลารวมของเส้นทาง แต่เส้นทางที่เร็วที่สุดยังไปถึงก่อนคาบเริ่ม\n"
    # "- `#C` เมื่อแม้ใช้เส้นทางที่เร็วที่สุดก็ไปไม่ทันคาบเริ่ม\n"
    # "\n"
    # "## หน่วยและการเข้ารหัส (Units & Encoding)\n"
    # "\n"
    # "- เวลาทั้งหมดเป็นข้อความรูปแบบ `\"HH:MM\"` แบบ 24 ชั่วโมง เช่น `\"09:00\"`\n"
    # "- `day` เป็นชื่อวันภาษาไทย: \"จันทร์\" ถึง \"อาทิตย์\"\n"
    # "- ระยะเวลาเป็นนาที (`Nat`) และระยะทางเป็นเมตร (`Nat`)\n"
    # "- ข้อความที่ผู้ใช้เห็นทั้งหมดเป็นภาษาไทย\n"
    # "- `RoutePlan.walkingSteps` และ `RoutePlan.evSteps` เป็นอาร์เรย์คำแนะนำทีละขั้น\n"
    # "- `AssistantAnswer.route` เป็น `?RoutePlan` — มีค่าเมื่อคำตอบนั้นมีเส้นทางมาด้วย\n"
    # "\n"
    # "## วงจรชีวิตและการถามซ้ำ (Lifecycle & Polling)\n"
    # "\n"
    # "- ทุกเมธอดเป็นแบบอ่านอย่างเดียวและตอบทันที ไม่มีงานเบื้องหลัง จึงไม่ต้อง polling\n"
    # "- **เวลาปัจจุบันของเดโมถูกตรึงไว้ที่ 08:30 น. เสมอ** (`demoNowClock` ใน `lib/schedule.mo`) "
    # "ทุกการคำนวณเวลาในเดโมใช้เวลาจำลองนี้ ไม่ใช้เวลาจริงของแคนนิสเตอร์หรือของอุปกรณ์ "
    # "ดังนั้น `minutesUntil` และ `estimatedArrival` จึงให้ผลเหมือนกันทุกครั้งที่เรียก ไม่ว่าเวลาจริงจะเป็นเท่าใด\n"
    # "- **วันเดโมถูกตรึงไว้ที่ \"จันทร์\" เสมอ** ตารางเรียนเป็นตารางรายสัปดาห์ และวันนี้ของเดโมไม่เปลี่ยนตามวันจริง "
    # "เพื่อให้ประสบการณ์ \"คาบถัดไป\" คงที่และทำซ้ำได้\n"
    # "- ที่เวลาเดโม 08:30 น. คาบถัดไปคือ ชีววิทยา 09:00 น. ห้อง SC-204 อาคารวิทยาศาสตร์ 2 "
    # "และ `getNextClass()` จะคืนค่า `null` เฉพาะเมื่อไม่มีคาบในวันจันทร์ที่เริ่มหลังเวลาจำลองนี้แล้วเท่านั้น\n"
    # "\n"
    # "## ความปลอดภัยในการเรียกซ้ำ (Mutation Retry Safety)\n"
    # "\n"
    # "- เมธอดโดเมนแคมปัสทั้งหมดเป็น `query` ไม่มีการเขียนสถานะ การเรียกซ้ำจึงปลอดภัยและให้ผลเดิม\n"
    # "- `scan()` เป็น update call แต่ **ไม่เขียนสถานะใด ๆ** และ **idempotent**: "
    # "เรียกซ้ำกี่ครั้งก็ได้ผลตรวจจับสาธิตเดิม (อาคารวิทยาศาสตร์ 2 / SC-204) เสมอ\n"
    # "\n"
    # "## ข้อผิดพลาดและข้อควรระวัง (Errors & Gotchas)\n"
    # "\n"
    # "- เมธอดเหล่านี้ไม่ trap จากข้อมูลนำเข้า: `planRoute()` และ `askCampus()` จะไม่รู้จักชื่อสถานที่ "
    # "หรือคำถามที่ไม่ตรงกฎ จะค่อย ๆ fallback ไปยังตำแหน่งเริ่มต้นของเดโมหรือคำตอบแบบ fallback แทนการโยนข้อผิดพลาด\n"
    # "- เมื่อต้นทางและปลายทางถูกจับคู่เป็นสถานที่เดียวกัน (รวมถึงกรณีที่ไม่รู้จักชื่อทั้งสอง) "
    # "เส้นทางจะเป็น 0 นาทีจากตำแหน่งเริ่มต้นของเดโมไปยังตำแหน่งเดิม\n"
    # "- `askCampus()` เป็น **deterministic และอิงกฎ** ไม่ได้เรียกบริการ AI ภายนอกใด ๆ "
    # "คำตอบจึงมาจากชุดข้อมูลสาธิตเท่านั้น\n"
    # "- `scan()` คืนผลตรวจจับสาธิตคงที่เสมอ (อาคารวิทยาศาสตร์ 2 / ชั้น 2 / ห้อง SC-204) "
    # "ผลลัพธ์จึงไม่เปลี่ยนตามจำนวนครั้งที่สแกน และไม่ขึ้นกับสถานะใด ๆ ของแคนนิสเตอร์\n"
    # "- `planRoute()` ใช้เวลานั่งรถ EV คงที่ 5 นาที และเวลาเดินต่อท้ายคงที่ 2 นาที เมื่อต้นทางและปลายทางต่างกัน "
    # "เส้นทางแนะนำจากโรงอาหารกลางไป SC-204 จึงเป็น เดิน 3 นาที + EV สาย 2 ประมาณ 5 นาที + เดินต่อ 2 นาที รวมประมาณ 10 นาที "
    # "ถึงประมาณ 08:40 น. ก่อนเรียน 20 นาที\n"
    # "- `getSmartMoment()` ใช้เส้นทางเดียวกับ `planRoute('โรงอาหารกลาง','SC-204')` และคาบเดียวกับ `getNextClass()` "
    # "ผลลัพธ์จึงสอดคล้องกันเสมอ และไม่ trap จากข้อมูลนำเข้าเพราะไม่รับพารามิเตอร์\n"
    # "- `arriveBeforeClass` เป็น `true` เมื่อไม่มีคาบเรียนเหลือในวันนั้น\n"
    # "- ข้อมูลทั้งหมดเป็นชุดสาธิตแบบอ่านอย่างเดียว ไม่มีเมธอดใดให้ผู้ใช้แก้ไขข้อมูลแคมปัส\n"
  };
};
